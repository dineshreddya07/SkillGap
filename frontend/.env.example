# SkillGap Frontend — Environment Variables
# Copy this file to .env.local for local overrides (git-ignored).
# In production (Vercel), set these as environment variables in the dashboard.

# Backend API base URL — no trailing slash.
# Leave empty (or omit) when running locally via `npm run dev`.
# The Vite dev proxy will forward /api → localhost:5000 automatically.
# In production, set this to your Render backend URL:
VITE_API_BASE_URL=https://your-skillgap-backend.onrender.com
